#include <stdio.h>
#define MAX 5

int stack[MAX];
int top = -1;

void push(int value) {
    if (top == MAX - 1) {
        printf("Stack overflow\n");
        return;
    }
    top++;
    stack[top] = value;
}

void pop() {
    if (top == -1) {
        printf("Stack underflow\n");
        return;
    }
    top--;
}

int main() {
    push(10);
    push(20);
    pop();
    push(30);

    printf("Top element is: %d\n", stack[top]);

    return 0;
}
